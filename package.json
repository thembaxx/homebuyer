{
  "name": "homebuyer-reality-check",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "serve out --listen 3000",
    "lint": "oxlint src scripts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts && python3 -m unittest discover -s scripts -p 'test_*.py'",
    "data:refresh": "python3 scripts/refresh-enrichment.py",
    "data:check": "python3 scripts/refresh-enrichment.py --check",
    "smoke": "node scripts/browser-smoke.mjs",
    "smoke:enrichment": "node scripts/enrichment-smoke.mjs",
    "smoke:discovery": "node scripts/discovery-smoke.mjs",
    "discovery": "tsx scripts/discovery-alias.ts",
    "prebuild": "npm run discovery",
    "predev": "tsx scripts/discovery-alias.ts --development"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "motion": "^12.23.24",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "serve": "^14.2.6",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "oxfmt": "latest",
    "oxlint": "latest",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
